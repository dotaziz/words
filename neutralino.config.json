{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.dotaziz.words",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "enableExtensions": false,
  "nativeAllowList": [
    "app.*",
    "os.*",
    "computer.*",
    "storage.*",
    "debug.log",
    "extensions.*",
    "window.*",
    "events.*"
  ],
  "globalVariables": {
    "DB_PATH": "database/dict_en_v2.db"
  },
  "modes": {
    "window": {
      "title": "Words Dictionary",
      "width": 450,
      "height": 700,
      "minWidth": 500,
      "minHeight": 800,
      "resizable": false,
      "maximize": false,
      "icon": "resources/icon.png",
      "enableInspector": true,
      "center": true,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "words",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  }
}
